# Server
PORT=4000
NODE_ENV=development

# Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/devaicon

# Session — must be >= 32 chars
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

# Allowed origin(s) for the Next.js client (comma-separated)
CLIENT_ORIGIN=http://localhost:3000

# Optional: lets publishing a post refresh the site's pages at once.
# SITE_URL is the Next.js site's origin; REVALIDATE_SECRET must match the
# client's. Without them pages still update, just a few minutes later.
# SITE_URL=http://localhost:3000
# REVALIDATE_SECRET=replace-with-another-long-random-string

# Optional: override Node's DNS resolver. Set this if Atlas (mongodb+srv://)
# connections fail with "querySrv ECONNREFUSED" because the system resolver
# is misconfigured (e.g. 127.0.0.1). Comma-separated public DNS servers.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Optional: seed users from these vars when running `npm run seed`.
# Pattern: {USERNAME}_PASSWORD=... — usernames starting with "admin" become Owners.
# Example:
# DEV1_PASSWORD=changeme
# ADMIN1_PASSWORD=changeme
